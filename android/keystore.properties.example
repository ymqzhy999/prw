# Copy to android/keystore.properties and fill in your own release keystore.
# Generate one with:
# keytool -genkeypair -v -keystore nuclear-release.jks -alias nuclear \
#   -keyalg RSA -keysize 2048 -validity 10000
storeFile=nuclear-release.jks
storePassword=CHANGE_ME
keyAlias=nuclear
keyPassword=CHANGE_ME
